# Supabaseプロジェクトの「Project Settings」→「API」から値をコピーしてください。
# このファイルをコピーして .env.local を作成し、実際の値を入力します。
#   cp .env.local.example .env.local
#
# .env.local はGit管理対象外（.gitignore）なので、秘密情報を書いても安全です。

# Supabase プロジェクトURL（例: https://xxxxxxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=

# Supabase の「anon / public」キー（公開しても問題ない前提のキーですが、念のため直書きせずここに集約します）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
